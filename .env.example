# OpsDesk Environment Configuration
# GEMINI_API_KEY: Google AI Studio API key
GEMINI_API_KEY=""

# GEMINI_MODEL: Configurable model name (defaults to gemini-3.5-flash-lite per deprecations guidance)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Database Connection (Default SQLite for local dev, PostgreSQL compatible)
DATABASE_URL="sqlite:///./opsdesk.db"

# Architecture Service Flags (Python reference implementations active by default)
SLA_ENGINE="python"   # python (default) | rust (future milestone)
REALTIME="off"        # off (default polling) | on (Go SSE gateway)
EXPORT="fastapi"      # fastapi (default StreamingResponse) | go (future streaming sidecar)
