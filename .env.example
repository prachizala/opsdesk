# OpsDesk Environment Configuration
# GEMINI_API_KEY: Google AI Studio API key
GEMINI_API_KEY=""

# GEMINI_MODEL: Configurable model name (defaults to gemini-3.5-flash-lite per deprecations guidance)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Database Connection (Default SQLite for local dev, PostgreSQL compatible)
DATABASE_URL="sqlite:///./opsdesk.db"

# Architecture Service Flags (RESERVED, not read by code; Python/polling/FastAPI is the only implementation)
SLA_ENGINE="python"   # RESERVED, not read by code; Python/polling/FastAPI is the only implementation
REALTIME="off"        # RESERVED, not read by code; Python/polling/FastAPI is the only implementation
EXPORT="fastapi"      # RESERVED, not read by code; Python/polling/FastAPI is the only implementation
